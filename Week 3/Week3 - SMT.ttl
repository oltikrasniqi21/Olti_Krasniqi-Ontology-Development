#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Breakdown_Event
:Breakdown_Event rdf:type owl:Class ;
                 rdfs:comment "Represents an unexpected tool failure or breakdown that temporarily stops production." ;
                 rdfs:label "Breakdown Event" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Lot
:Lot rdf:type owl:Class ;
     rdfs:comment "Represents a specific physical batch of wafers moving through the factory together" ;
     rdfs:label "Lot" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#PM_Event
:PM_Event rdf:type owl:Class ;
          rdfs:comment "Represents a scheduled preventive maintenance activity designed to keep tools running reliably" ;
          rdfs:label "Preventive Maintenance Event" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Process_Step
:Process_Step rdf:type owl:Class ;
              rdfs:comment "A manufacturing activity that represents a specific operation performed during the production process to transform inputs into outputs." ;
              rdfs:label "Process Step" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Product
:Product rdf:type owl:Class ;
         rdfs:comment "Represents an individual manufacturing operation or step along a product's route." ;
         rdfs:label "Product" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Route
:Route rdf:type owl:Class ;
       rdfs:comment "Specifies the step-by-step process sequence required to build a product." ;
       rdfs:label "Route" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Setup
:Setup rdf:type owl:Class ;
       rdfs:comment "Defines a process step's required operating configuration and the setup time needed to switch between product types" ;
       rdfs:label "Setup" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Tool
:Tool rdf:type owl:Class ;
      rdfs:subClassOf :Tool_Group ;
      rdfs:comment "Represents a single physical tool or machine in the manufacturing plant." ;
      rdfs:label "Tool" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Tool_Group
:Tool_Group rdf:type owl:Class ;
            rdfs:comment "A collection or category of manufacturing tools or equipment that perform similar functions or are used for related production operations." ;
            rdfs:label "Tool Group" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/Infenion-week3#Transport
:Transport rdf:type owl:Class ;
           rdfs:comment "Defines the travel time and logistical movement of wafer lots between different tool locations." ;
           rdfs:label "Transport" .


