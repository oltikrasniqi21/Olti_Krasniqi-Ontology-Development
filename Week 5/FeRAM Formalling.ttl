@prefix : <http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/> .

<http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling> rdf:type owl:Ontology ;
                                                                        rdfs:comment """This ontology formalizes manufacturing process flow of CMOS Steps in FeRAM production. 
In the 1T1C architecture, the CMOS transistor acts as the access or selection
device, while the ferroelectric capacitor (FeCAP) provides the non-volatile storage element.""" .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/characterizesMaterial
:characterizesMaterial rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf owl:topObjectProperty ;
                       rdfs:domain :Quality_Check ;
                       rdfs:range :Material ;
                       rdfs:comment "Links quality checks to target materials under evaluation." ;
                       rdfs:label "characterizes material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/characterizesStep
:characterizesStep rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain :Quality_Check ;
                   rdfs:range :Process_Steps ;
                   rdfs:comment "Links physical or electrical inspection routines to process steps." ;
                   rdfs:label "characterizes step" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/consumesChemical
:consumesChemical rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :CMP_Step
                                              :Etch_Step
                                              :Wafer_Cleaning
                                            )
                              ] ;
                  rdfs:range :Material ;
                  rdfs:comment "Relates a chemical, etching, or cleaning step to constituent materials used." ;
                  rdfs:label "consumes chemical" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/depositsMaterial
:depositsMaterial rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain :Deposition_Step ;
                  rdfs:range :Material ;
                  rdfs:comment "Relates a deposition step to the material thin film laid down." ;
                  rdfs:label "deposits material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/followedBy
:followedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Process_Steps ;
            rdfs:range :Process_Steps ;
            rdfs:comment "Defines execution sequence order between consecutive process steps." ;
            rdfs:label "followed by" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/formsOutputPart
:formsOutputPart rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :Electrode_Deposition
                                             :HfO2_Deposition
                                             :Metallization
                                           )
                             ] ;
                 rdfs:range :Output ;
                 rdfs:comment "Links constructive process steps to structural output components created." ;
                 rdfs:label "forms output part" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasSubmodule
:hasSubmodule rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Process_Steps ;
              rdfs:range :Process_Steps ;
              rdfs:comment "Models sub-process steps embedded inside larger modular sequences." ;
              rdfs:label "has submodule" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/isPartOfOutput
:isPartOfOutput rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Output ;
                rdfs:range :Output ;
                rdfs:comment "Hierarchy relation modeling components within higher-level assemblies." ;
                rdfs:label "is part of output" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/modifiesOutputPart
:modifiesOutputPart rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf owl:topObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Annealing
                                                :Implantation
                                                :Oxidation
                                              )
                                ] ;
                    rdfs:range :Output ;
                    rdfs:comment "Links structural altering steps like annealing or doping to output parts." ;
                    rdfs:label "modifies output part" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain :Process_Steps ;
          rdfs:range :Output ;
          rdfs:comment "Relates process execution to final target output items." ;
          rdfs:label "produces" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/usesEquipment
:usesEquipment rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Process_Steps ;
               rdfs:range :Equipment ;
               rdfs:comment "Maps fabrication process steps to equipment tools required." ;
               rdfs:label "uses equipment" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/usesMaterial
:usesMaterial rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Process_Steps ;
              rdfs:range :Material ;
              rdfs:label "maps process steps to raw or consumable materials utilized." .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/validates
:validates rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf owl:topObjectProperty ;
           rdfs:domain :Quality_Check ;
           rdfs:range :Output ;
           rdfs:comment "Links inspection procedures to component structures being validated." ;
           rdfs:label "validates" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasBreakdownField
:hasBreakdownField rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :Capacitor_Stack
                                               :FerroelectricMaterial
                                             )
                               ] ;
                   rdfs:range xsd:float ;
                   rdfs:comment "Dielectric breakdown electric field strength (Ebd) in MV/cm." ;
                   rdfs:label "has breakdown field" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasCoerciveField
:hasCoerciveField rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Capacitor_Stack
                                              :FerroelectricMaterial
                                            )
                              ] ;
                  rdfs:range xsd:float ;
                  rdfs:comment "Coercive electric field (Ec) in kV/cm." ;
                  rdfs:label "has coercive field" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasCriticalDimension
:hasCriticalDimension rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :Output
                                                  :Process_Steps
                                                )
                                  ] ;
                      rdfs:range xsd:float ;
                      rdfs:comment "Target critical dimension (CD) or linewidth pitch in nm." ;
                      rdfs:label "has critical dimension" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasDopingConcentration
:hasDopingConcentration rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :FerroelectricMaterial
                                                    :SemiconductorMaterial
                                                  )
                                    ] ;
                        rdfs:range xsd:float ;
                        rdfs:comment "Doping concentration percentage or atomic concentration." ;
                        rdfs:label "has doping concentration" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasDuration
:hasDuration rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Process_Steps ;
             rdfs:range xsd:float ;
             rdfs:comment "Process execution time in seconds." ;
             rdfs:label "has duration" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasEnduranceCycles
:hasEnduranceCycles rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Capacitor_Stack
                                                :Memory_Array
                                                :Memory_Cell
                                              )
                                ] ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "Maximum allowable switching write cycles prior to fatigue failure." ;
                    rdfs:label "has endurance cycles" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasFilmThickness
:hasFilmThickness rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain [ rdf:type owl:Class ;
                                owl:unionOf ( :Material
                                              :Output
                                            )
                              ] ;
                  rdfs:range xsd:float ;
                  rdfs:comment "Film or layer thickness measured in nm." ;
                  rdfs:label "has film thickness" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasGasFlowRate
:hasGasFlowRate rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain :Process_Steps ;
                rdfs:range xsd:float ;
                rdfs:comment "Precursor or carrier gas flow rate setpoint in sccm." ;
                rdfs:label "has gas flow rate" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasLeakageCurrentDensity
:hasLeakageCurrentDensity rdf:type owl:DatatypeProperty ;
                          rdfs:subPropertyOf owl:topDataProperty ;
                          rdfs:domain [ rdf:type owl:Class ;
                                        owl:unionOf ( :Capacitor_Stack
                                                      :FerroelectricMaterial
                                                    )
                                      ] ;
                          rdfs:range xsd:float ;
                          rdfs:comment "Leakage current density measured in A/cm²." ;
                          rdfs:label "has leakage current density" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasPressure
:hasPressure rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Process_Steps ;
             rdfs:range xsd:float ;
             rdfs:comment "Process chamber pressure setpoint in Torr or mBar." ;
             rdfs:label "has pressure" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasRFPower
:hasRFPower rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :Process_Steps ;
            rdfs:range xsd:float ;
            rdfs:comment "Plasma RF power delivery in Watts." ;
            rdfs:label "has RF power" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasRemnantPolarization
:hasRemnantPolarization rdf:type owl:DatatypeProperty ;
                        rdfs:subPropertyOf owl:topDataProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :Capacitor_Stack
                                                    :FerroelectricMaterial
                                                  )
                                    ] ;
                        rdfs:range xsd:float ;
                        rdfs:comment "Remnant polarization (Pr) in µC/cm²." ;
                        rdfs:label "has remnant polarization" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasSurfaceRoughness
:hasSurfaceRoughness rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :Material
                                                 :Output
                                               )
                                 ] ;
                     rdfs:range xsd:float ;
                     rdfs:comment "RMS surface roughness (Sq/Sa) measured in nm." ;
                     rdfs:label "has surface roughness" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/hasTemperature
:hasTemperature rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf owl:topDataProperty ;
                rdfs:domain :Process_Steps ;
                rdfs:range xsd:float ;
                rdfs:comment "Process execution temperature in °C." ;
                rdfs:label "has temperature" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/isCMOSCompatible
:isCMOSCompatible rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Material ;
                  rdfs:range xsd:boolean ;
                  rdfs:comment "Boolean flag indicating thermal/chemical compatibility with CMOS processes." ;
                  rdfs:label "is CMOS compatible" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/isPassed
:isPassed rdf:type owl:DatatypeProperty ;
          rdfs:subPropertyOf owl:topDataProperty ;
          rdfs:domain :Quality_Check ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Pass/Fail evaluation result flag for physical or electrical checks." ;
          rdfs:label "is passed" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/ALDSystem
:ALDSystem rdf:type owl:Class ;
           rdfs:subClassOf :Equipment ;
           rdfs:comment "Atomic Layer Deposition cluster system." ;
           rdfs:label "ALD System" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Annealing
:Annealing rdf:type owl:Class ;
           rdfs:subClassOf :Process_Steps ;
           rdfs:comment "Thermal annealing step used for crystallization or stress relief." ;
           rdfs:label "Annealing" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/CMPTool
:CMPTool rdf:type owl:Class ;
         rdfs:subClassOf :Equipment ;
         rdfs:comment "Chemical Mechanical Planarization polishing system." ;
         rdfs:label "CMP Tool" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/CMP_Step
:CMP_Step rdf:type owl:Class ;
          rdfs:subClassOf :Process_Steps ;
          rdfs:comment "Chemical Mechanical Planarization polishing step." ;
          rdfs:label "CMP Step" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Capacitor_Stack
:Capacitor_Stack rdf:type owl:Class ;
                 rdfs:subClassOf :Output ;
                 rdfs:comment "Metal-Insulator-Metal (MIM) ferroelectric capacitor stack entity." ;
                 rdfs:label "Capacitor Stack" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Deposition_Step
:Deposition_Step rdf:type owl:Class ;
                 rdfs:subClassOf :Process_Steps ;
                 rdfs:comment "Generalized material film growth or deposition process step." ;
                 rdfs:label "Deposition Step" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/DielectricMaterial
:DielectricMaterial rdf:type owl:Class ;
                    rdfs:subClassOf :Material ;
                    rdfs:comment "Non-conductive insulating oxides or nitrides." ;
                    rdfs:label "Dielectric Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/ElectricalCharacterization
:ElectricalCharacterization rdf:type owl:Class ;
                            rdfs:subClassOf :Quality_Check ;
                            owl:disjointWith :PhysicalMetrology ;
                            rdfs:comment "Metrology assessing C-V, P-V, leakage, and fatigue performance." ;
                            rdfs:label "Electrical Characterization" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/ElectrodeMaterial
:ElectrodeMaterial rdf:type owl:Class ;
                   rdfs:subClassOf :Material ;
                   rdfs:comment "Conductive materials used for top/bottom capacitor plates and plugs." ;
                   rdfs:label "Electrode Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Electrode_Deposition
:Electrode_Deposition rdf:type owl:Class ;
                      rdfs:subClassOf :Process_Steps ;
                      rdfs:comment "Process step specifically depositing conductive electrode films." ;
                      rdfs:label "Electrode Deposition" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Equipment
:Equipment rdf:type owl:Class ;
           rdfs:comment "Base class representing fabrication tools and machinery." ;
           rdfs:label "Equipment" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Etch_Step
:Etch_Step rdf:type owl:Class ;
           rdfs:subClassOf :Process_Steps ;
           rdfs:comment "Subtractive material removal step via wet chemical or plasma etching." ;
           rdfs:label "Etch Step" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Etcher
:Etcher rdf:type owl:Class ;
        rdfs:subClassOf :Equipment ;
        rdfs:comment "Plasma Reactive Ion Etch (RIE) system." ;
        rdfs:label "Etcher" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/FerroelectricMaterial
:FerroelectricMaterial rdf:type owl:Class ;
                       rdfs:subClassOf :Material ;
                       owl:disjointWith :SemiconductorMaterial ;
                       rdfs:comment "Polarizable dielectric material exhibiting remnant polarization." ;
                       rdfs:label "Ferroelectric Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Ferroelectric_Memory
:Ferroelectric_Memory rdf:type owl:Class ;
                      rdfs:subClassOf :Output ;
                      rdfs:comment "Complete packaged integrated FeRAM chip or die assembly." ;
                      rdfs:label "Ferroelectric Memory" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Furnace
:Furnace rdf:type owl:Class ;
         rdfs:subClassOf :Equipment ;
         rdfs:comment "Thermal furnace or Rapid Thermal Annealing (RTA) chamber." ;
         rdfs:label "Furnace" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/HfO2_Deposition
:HfO2_Deposition rdf:type owl:Class ;
                 rdfs:subClassOf :Process_Steps ;
                 rdfs:comment "Atomic Layer Deposition step specifically growing HfO2-based dielectric films." ;
                 rdfs:label "HfO2 Deposition" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Implantation
:Implantation rdf:type owl:Class ;
              rdfs:subClassOf :Process_Steps ;
              rdfs:comment "Ion implantation step modifying semiconductor carrier concentrations." ;
              rdfs:label "Implantation" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Lithography
:Lithography rdf:type owl:Class ;
             rdfs:subClassOf :Process_Steps ;
             rdfs:comment "Photolithographic pattern transfer onto photoresist films." ;
             rdfs:label "Lithography" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/LithographyTool
:LithographyTool rdf:type owl:Class ;
                 rdfs:subClassOf :Equipment ;
                 rdfs:comment "Photolithographic exposure stepper or scanner tool." ;
                 rdfs:label "Lithography Tool" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Material
:Material rdf:type owl:Class ;
          rdfs:comment "Base class covering chemical elements, compounds, and gas precursors." ;
          rdfs:label "Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Memory_Array
:Memory_Array rdf:type owl:Class ;
              rdfs:subClassOf :Output ;
              rdfs:comment "Structured matrix array containing interconnected bit-cells." ;
              rdfs:label "Memory Array" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Memory_Cell
:Memory_Cell rdf:type owl:Class ;
             rdfs:subClassOf :Output ;
             rdfs:comment "Single 1T1C or 2T2C functional unit cell." ;
             rdfs:label "Memory Cell" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Metallization
:Metallization rdf:type owl:Class ;
               rdfs:subClassOf :Process_Steps ;
               rdfs:comment "Patterning and formation of conductive interconnect lines and contacts." ;
               rdfs:label "Metallization" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Output
:Output rdf:type owl:Class ;
        rdfs:comment "Base class for fabricated physical components and device structures." ;
        rdfs:label "Output" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Oxidation
:Oxidation rdf:type owl:Class ;
           rdfs:subClassOf :Process_Steps ;
           rdfs:comment "Thermal growth of oxide films." ;
           rdfs:label "Oxidation" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/PVDSystem
:PVDSystem rdf:type owl:Class ;
           rdfs:subClassOf :Equipment ;
           rdfs:comment "Physical Vapor Deposition sputtering tool." ;
           rdfs:label "PVD System" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/PhotoresistMaterial
:PhotoresistMaterial rdf:type owl:Class ;
                     rdfs:subClassOf :Material ;
                     rdfs:comment "Light-sensitive organic polymeric materials used in lithography." ;
                     rdfs:label "Photoresist Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/PhysicalMetrology
:PhysicalMetrology rdf:type owl:Class ;
                   rdfs:subClassOf :Quality_Check ;
                   rdfs:comment "Inspection routines measuring film thickness, grain phase, and surface morphology." ;
                   rdfs:label "Physical Metrology" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Process_Steps
:Process_Steps rdf:type owl:Class ;
               rdfs:comment "Base class covering individual unit processing steps." ;
               rdfs:label "Process Steps" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Quality_Check
:Quality_Check rdf:type owl:Class ;
               rdfs:comment "Base class for process inspection and metrology routines." ;
               rdfs:label "Quality Check" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/SemiconductorMaterial
:SemiconductorMaterial rdf:type owl:Class ;
                       rdfs:subClassOf :Material ;
                       rdfs:comment "Substrate or active layer materials such as Silicon or Germanium." ;
                       rdfs:label "Semiconductor Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/SubstrateMaterial
:SubstrateMaterial rdf:type owl:Class ;
                   rdfs:subClassOf :Material ;
                   rdfs:comment "Base wafer material providing structural support." ;
                   rdfs:label "Substrate Material" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Testing
:Testing rdf:type owl:Class ;
         rdfs:subClassOf :Process_Steps ;
         rdfs:comment "Electrical parametric, wafer-level functional testing step." ;
         rdfs:label "Testing" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Wafer_Cleaning
:Wafer_Cleaning rdf:type owl:Class ;
                rdfs:subClassOf :Process_Steps ;
                rdfs:comment "Surface preparation and contamination removal step." ;
                rdfs:label "Wafer Cleaning" .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling#SiDoped_HfO2_Film_10nm
:SiDoped_HfO2_Film_10nm rdf:type owl:NamedIndividual ,
                                 :FerroelectricMaterial .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/ASML_EUV_Stepper
:ASML_EUV_Stepper rdf:type owl:NamedIndividual ,
                           :LithographyTool ;
                  rdfs:comment "Extreme Ultraviolet (EUV) photolithography exposure tool." ;
                  rdfs:label "ASML EUV Stepper" .


###  http://www.semanticweb.org/oltipc/ontologies/2026/7/FeRAM-formalling/Al2O3_Capping_Layer
:Al2O3_Capping_Layer rdf:type owl:NamedIndividual ,
                              :DielectricMaterial ;
                     rdfs:comment "Thin aluminum oxide protective oxygen-barrier layer." ;
                     rdfs:label "Al2O3 Capping Layer" .


